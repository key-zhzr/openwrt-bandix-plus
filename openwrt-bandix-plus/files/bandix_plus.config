config bandix_plus 'general'
	# Whether to start traffic collection (--enable-traffic)
	option enable_traffic '1'

	# Multi-interface monitoring targets (repeat with `list iface`)
	list iface 'br-lan'
	# list iface 'pppoe-WAN'
	# list iface 'eth1.11'
	# list iface 'tailscale0'

	# Core runtime options
	option log_level 'info'
	option tc_backend 'auto'
	option tc_order 'default'
	option netlink_priority '0'
	# option tcx_anchor_ingress_id '12345'
	# option tcx_anchor_egress_id '12346'
	option traffic_enable_storage '0'
	# Days of hourly buckets to keep when storage is enabled (0 = forever)
	option traffic_retention_days '366'
	# In-memory recent trend window in minutes
	option history_window_minutes '10'
	option host '127.0.0.1'
	option port '8787'
	option data_dir '/usr/share/bandix-plus'
